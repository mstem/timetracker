# User credentials — never commit these
config.json
project_mappings.json*
google_tokens.json

# Runtime state
sent_dates.json
synced_meetings.json
tracker.log
launchd_stdout.log
launchd_stderr.log
logs/

# Generated by setup.sh (contains absolute paths for your machine)
com.terminaltracker.plist
com.terminaltracker.watchdog-process.plist
com.terminaltracker.watchdog-health.plist

# AI matcher logs
ai_matcher.log
ai_matcher_stdout.log
ai_matcher_stderr.log

# App bundle: keep Info.plist + launcher (source), ignore the local ad-hoc
# signature (regenerated per-machine by setup.sh's codesign step)
TimeTracker.app/Contents/_CodeSignature/

# Python
__pycache__/
*.pyc
.DS_Store
